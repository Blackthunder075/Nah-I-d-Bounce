[sub_resource type="GDScript" id="GDScript_eqrm3"]
script/source = "extends CharacterBody2D


@export var move_speed : float = 220.0

@export var bounce_speed: float = 600.0
@export var bounce_duration: float = 0.35

var is_bouncing: bool = false
var bounce_direction: Vector2 = Vector2.ZERO
var bounce_timer: float = 0.0



func _physics_process(delta):
	if is_bouncing:
		bounce_timer -= delta

		velocity = bounce_direction * bounce_speed

		if bounce_timer <= 0:
			is_bouncing = false
			velocity = Vector2.ZERO

	else:
		var input_direction = Input.get_vector(
			\"move_left\",
			\"move_right\",
			\"move_up\",
            \"move_down\"
		)

		velocity = input_direction * move_speed

	move_and_slide()



func _input(event):
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
			start_bounce()



func start_bounce():
	if is_bouncing:
		return

	bounce_direction = global_position.direction_to(
		get_global_mouse_position()
	)

	is_bouncing = true
	bounce_timer = bounce_duration
"

