[sub_resource type="GDScript" id="GDScript_eqrm3"]
script/source = "extends CharacterBody2D


@export var starting_mass: float = 10.0
@export var growth_multiplier: float = 0.12
@export var maximum_scale: float = 3.0
var mass: float = 10.0
var base_scale: Vector2 = Vector2.ONE
@export var bounce_damage: float = 15.0
@export var rebound_speed: float = 450.0 
@export var move_speed : float = 220.0
@export var bounce_speed: float = 600.0
@export var bounce_duration: float = 0.35
var is_bouncing: bool = false
var bounce_direction: Vector2 = Vector2.ZERO
var bounce_timer: float = 0.0

func _physics_process(delta):
	if is_bouncing:
		bounce_timer -= delta

		velocity = bounce_direction * bounce_speed

		if bounce_timer <= 0:
			is_bouncing = false
			velocity = Vector2.ZERO

	else:
		var input_direction = Input.get_vector(
			\"move_left\",
			\"move_right\",
			\"move_up\",
            \"move_down\"
		)

		velocity = input_direction * move_speed

	move_and_slide()
	if is_bouncing:
		check_bounce_collision()

func _input(event):
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
			start_bounce()



func start_bounce():
	if is_bouncing:
		return

	bounce_direction = global_position.direction_to(
		get_global_mouse_position()
	)

	is_bouncing = true
	bounce_timer = bounce_duration
	
	
func check_bounce_collision():
	for i in get_slide_collision_count():
		var collision = get_slide_collision(i)
		var collider = collision.get_collider()

		if collider.is_in_group(\"enemies\"):
			collider.take_damage(bounce_damage)

			bounce_direction = -collision.get_normal()
			bounce_timer = bounce_duration
			velocity = bounce_direction * rebound_speed


func _ready():
	mass = starting_mass
	base_scale = scale
	update_slime_scale()


func update_slime_scale():
	var growth = sqrt(mass / starting_mass)

	growth = clamp(growth, 1.0, maximum_scale)
	scale = base_scale * growth


func absorb_enemy(enemy_mass: float):
	mass += enemy_mass
	update_slime_scale()
	print(\"Current mass: \", mass)
"

